":2579728919,"n":"Basement storage key","r":"key_doorkey_klinte_basement","s":"doors","a":1,"p":1413277686,"d":"The key to a storage room in Klinte.","x":"mountains, near Klinte Harbor Ferry Pier (~150 m)","i":"generic_key_alpha.png"},{"h":2088870199,"n":"Björn's barn key","r":"key_doorkey_wm39","s":"doors","a":1,"p":1413277686,"d":"A key to old man Björn's barn.","m":1,"x":"marshlands, near Stenmyra Settlement (~200 m)","i":"generic_key_alpha.png"},{"h":4192062974,"n":"Crafting Container key","r":"key_doorkey_crafting07","s":"doors","a":1,"p":3867371168,"d":"A key to the locked Crafting Container from the raft","i":"generic_key_alpha.png"},{"h":29280497,"n":"Garage Key","r":"key_doorkey_crafting04","s":"doors","a":1,"p":3867371168,"d":"Key to the garage at Vassholmens villa","i":"generic_key_bunker_iff_alpha.png"},{"h":39247827,"n":"Hangar Key","r":"key_doorkey_crafting03","s":"doors","a":1,"p":3867371168,"d":"A key to the locked Hangar at BAS 90","i":"generic_key_bunker_iff_alpha.png"},{"h":3603109944,"n":"Hjortqvarns Sågverk key","r":"key_doorkey_wm27a","s":"doors","a":1,"p":1413277686,"d":"A key to the office cabin at the Hjortqvarns Sågverk (sawmill) lumberyard.","m":1,"i":"generic_key_alpha.png"},{"h":728173567,"n":"House key","r":"key_doorkey_wm16b","s":"doors","a":1,"p":1413277686,"d":"The key is of a generic make and has a blood stain on it.","m":1,"i":"generic_key_alpha.png"},{"h":1976000322,"n":"Key to Ingrid Granqvist's house","r":"key_doorkey_ingrid","s":"doors","a":1,"p":1413277686,"d":"The key has a label on it: \"Dr Ingrid Granqvist.\"","m":1,"i":"generic_key_alpha.png"},{"h":236413068,"n":"Key to Stora Dyrbo barn","r":"key_doorkey_wm22b","s":"doors","a":1,"p":1413277686,"d":"A key to the locked barn at Stora Dyrbo.","m":1,"i":"generic_key_alpha.png"},{"h":1105156184,"n":"Key to the stables at Glättra","r":"key_doorkey_wm17","s":"doors","a":1,"p":1413277686,"d":"A key to the stables at Glättra farm.","m":1,"i":"generic_key_alpha.png"},{"h":1388236909